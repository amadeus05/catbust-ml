# Единые окончания строк в репозитории (LF) — меньше предупреждений Git про CRLF/LF
* text=auto eol=lf

# Скрипты Windows: в репозитории часто оставляют CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

